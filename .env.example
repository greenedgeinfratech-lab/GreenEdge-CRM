# ===========================================
# GreenEdge CRM — Environment Variables
# ===========================================
# Copy this file to .env and fill in real values for production.
# On Railway, set these as service variables in the dashboard.

# ---- Django Core ----
SECRET_KEY=change-me-to-a-strong-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.railway.app

# ---- Database (Railway provides DATABASE_URL automatically) ----
DATABASE_URL=postgres://user:password@host:5432/dbname

# ---- Redis (Railway provides REDIS_URL automatically) ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# ---- CORS & CSRF (set to your frontend's Railway URL) ----
CORS_ALLOWED_ORIGINS=https://your-frontend.up.railway.app,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://your-frontend.up.railway.app,http://localhost:3000

# ---- Security ----
SECURE_SSL_REDIRECT=False

# ---- Celery ----
CELERY_TASK_ALWAYS_EAGER=False

# ---- Email ----
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# ---- Twilio/WhatsApp ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
